# OrbitSwap Pro - Environment Configuration
#
# Configure your Stellar network connection and deployed contract addresses.
# Copy this file to .env and fill in your values.

# ─── Application ────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# ─── Stellar Network ────────────────────────────────────────────────────────
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── Deployed Contract Addresses ────────────────────────────────────────────
# Fill these in after deploying contracts to the network.
VITE_CONTRACT_ROUTER=
VITE_CONTRACT_LIQUIDITY_POOL=
VITE_CONTRACT_FEE_VAULT=
VITE_CONTRACT_TREASURY=
VITE_CONTRACT_SWAP_REGISTRY=
VITE_CONTRACT_EVENT=
