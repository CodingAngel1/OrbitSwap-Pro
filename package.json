{
  "name": "orbitswap-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade decentralized exchange powered by Stellar",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@stellar/stellar-base": "^15.0.0",
    "@stellar/stellar-sdk": "^16.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^24.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^2.0.0"
  }
}
